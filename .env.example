# Logging level for monitor.py and scheduler.py entrypoints (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Buffer in degrees for the PROXIMO geographic scope (default 5.0 ~ 500 km)
ALERTAVIDA_BUFFER_PROXIMO_GRAUS=5.0
# SQLite database path (default: data/alertavida.db, relative to the package).
# Blank or unset falls back to the default. The parent directory is created on
# first connection, not at import time.
ALERTAVIDA_DB_PATH=data/alertavida.db
