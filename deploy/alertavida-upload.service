[Unit]
Description=AlertaVida backup upload to Google Drive
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=alertavida
Group=alertavida
UMask=0007
# rclone resolves its cache and config relative to HOME; /opt/alertavida is
# read-only under ProtectSystem=strict, so HOME points at the one writable
# path this unit has.
Environment=HOME=/var/lib/alertavida
ExecStart=/opt/alertavida/deploy/upload.sh

# Same hardening as alertavida-backup.service. Unlike that unit, this one
# does open outbound connections (Google Drive API) — it still has no
# listeners and only needs to write inside /var/lib/alertavida.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/alertavida

# Sandboxing (#133). None of these processes needs devices, kernel
# tunables/modules/logs, other users' processes, namespaces, realtime
# scheduling, SUID binaries or any capability — denying them limits what
# code running under this unit could do if a dependency were ever
# exploited. Verified on the Azure VM with `systemd-analyze security`
# before/after and a real run of each unit (wiki/decisions/systemd-sandboxing.md).
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# Outbound HTTPS plus local DNS (systemd-resolved over AF_UNIX/loopback).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
